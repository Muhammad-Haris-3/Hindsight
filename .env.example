# Free key: https://fredaccount.stlouisfed.org/apikeys
HINDSIGHT_FRED_API_KEY=

# Admin, for scripts/migrate.py only.
HINDSIGHT_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# INSERT on observations, nothing else. Used by the pipeline.
HINDSIGHT_WRITER_DSN=postgresql://hindsight_writer:writer@localhost:5432/postgres

# SELECT only. Used by the API.
HINDSIGHT_READER_DSN=postgresql://hindsight_reader:reader@localhost:5432/postgres
